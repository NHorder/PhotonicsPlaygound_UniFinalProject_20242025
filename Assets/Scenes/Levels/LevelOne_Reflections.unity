    - target: {fileID: 176576259940256833, guid: 9a313d7801fc50c42a21be74b3fb3ea6, type: 3}
      propertyPath: teachingElements.Array.data[4].spirteNameB
      value: Fyrefly (Active)
      objectReference: {fileID: 0}
    - target: {fileID: 176576259940256833, guid: 9a313d7801fc50c42a21be74b3fb3ea6, type: 3}
      propertyPath: teachingElements.Array.data[4].spriteNameA
