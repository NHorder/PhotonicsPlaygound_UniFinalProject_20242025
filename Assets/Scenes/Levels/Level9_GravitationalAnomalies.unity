      value: Handler On
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[0].teachingInfo
      value: Warning! Gravitational Anomalies have been detected within your zone.
        Gravitational Anomalies may destroy satellites and are hard to notice. Due
        to this mission being priority one, we need you to continue with your mission.
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[0].usingSpriteA
