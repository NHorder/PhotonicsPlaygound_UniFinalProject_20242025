      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[0].usingSpriteB
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[1].teachingInfo
      value: "I\u2019ve been notified of the gravitational anomalies within your
        area, don\u2019t panic. In fact, you might be able to use them. Ever tried
        slingshotting light around a black hole before? Good luck, I\u2019ll be monitoring
        your progress and the anomalies. - Handler One"
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[1].usingSpriteA
