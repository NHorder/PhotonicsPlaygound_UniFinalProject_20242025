      value: Introduction
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[0].spriteNameAWelsh
      value: Rhybudd Coch Blaenoriaethol!
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[0].spriteNameBWelsh
      value: Anghysondebau Disgyrchiant
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[1].spriteNameAWelsh
      value: Triniwr Un
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[1].spriteNameBWelsh
      value: Anghysondebau Disgyrchiant
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[0].teachingInfoWelsh
      value: "Rhybudd! Mae Anghysondebau Disgyrchiant wedi'u canfod yn eich parth.
        Gall anomaleddau disgyrchiant ddinistrio lloerennau ac maent yn anodd sylwi.
        Oherwydd bod y genhadaeth hon yn flaenoriaeth un, mae angen i chi barhau
        \xE2'ch cenhadaeth."
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[1].teachingInfoWelsh
      value: "Rydw i wedi cael gwybod am yr anghysondebau disgyrchiant yn eich ardal,
        peidiwch \xE2 mynd i banig. Mewn gwirionedd, efallai y byddwch chi'n gallu
        eu defnyddio. Erioed wedi ceisio taflu golau o amgylch twll du o'r blaen?
        Pob lwc, byddaf yn monitro chi a'r anghysondebau. - Triniwr Un"
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[0].teachingTitleWelsh
      value: Rhybudd Coch Blaenoriaethol!
      objectReference: {fileID: 0}
    - target: {fileID: 7544388290579987951, guid: eafc6440e8a55484db4d89c2bfcd8739, type: 3}
      propertyPath: teachingElements.Array.data[1].teachingTitleWelsh
      value: Not Cyflwyniad
      objectReference: {fileID: 0}
